#!/bin/sh
# Gradle Wrapper bootstrap. Gradle is licensed under the Apache License, Version 2.0.
# https://www.apache.org/licenses/LICENSE-2.0
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
if [ -n "$JAVA_HOME" ]; then JAVACMD="$JAVA_HOME/bin/java"; else JAVACMD=java; fi
exec "$JAVACMD" -Xms64m -Xmx64m -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
