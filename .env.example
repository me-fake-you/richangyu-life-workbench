# 智能中心默认会在没有密钥时使用本地统计与检索。
# 如需 NVIDIA 模型，把 AI_PROVIDER 改为 nvidia，并分别填写文字与视觉密钥。
AI_PROVIDER=local

NVIDIA_TEXT_API_KEY=
NVIDIA_VISION_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# 如果以后改用 OpenAI API，可填写下面两项并把 AI_PROVIDER 改为 openai。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini

# Cloudflare 独立部署配置。D1_DATABASE_ID 来自 wrangler d1 create 的输出。
D1_DATABASE_ID=
D1_DATABASE_NAME=life-workbench
R2_BUCKET_NAME=life-workbench-media
CLOUDFLARE_WORKER_NAME=life-workbench
