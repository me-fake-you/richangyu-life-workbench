{
  "name": "richangyu-life-workbench",
  "version": "1.6.0",
  "description": "开源、隐私优先的个人生活工作台，覆盖记录、计划、财务、兼职、情报与长期回顾。",
  "private": true,
  "license": "MIT",
  "keywords": [
    "life-os",
    "personal-dashboard",
    "self-hosted",
    "cloudflare",
    "pwa",
    "生活记录",
    "生活工作台"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run check:encoding && npm run build",
    "android:setup": "node scripts/native-android-project.mjs setup",
    "android:release": "pwsh -File ./scripts/build-android-release.ps1 -BuildType release",
    "android:release:internal": "pwsh -File ./scripts/release-and-upload-android.ps1 -Track internal -Status completed",
    "android:release:production": "pwsh -File ./scripts/release-and-upload-android.ps1 -Track production -Status completed",
    "android:release:internal:build-only": "pwsh -File ./scripts/release-and-upload-android.ps1 -Track internal -SkipUpload",
    "android:release:internal:upload-only": "pwsh -File ./scripts/release-and-upload-android.ps1 -Track internal -UploadOnly",
    "android:release:production:build-only": "pwsh -File ./scripts/release-and-upload-android.ps1 -Track production -SkipUpload",
    "android:release:production:upload-only": "pwsh -File ./scripts/release-and-upload-android.ps1 -Track production -UploadOnly",
    "android:release:status": "pwsh -File ./scripts/android-release-status.ps1",
    "android:release:status:strict": "pwsh -File ./scripts/android-release-status.ps1 -Strict",
    "android:build": "pwsh -File ./scripts/build-android-release.ps1",
    "android:keystore": "pwsh -File ./scripts/generate-android-keystore.ps1",
    "android:version": "pwsh -File ./scripts/bump-android-version.ps1",
    "android:check": "pwsh -File ./scripts/check-android-release-readiness.ps1",
    "android:build:debug": "pwsh -File ./scripts/build-android-release.ps1 -BuildType debug",
    "android:build:release": "pwsh -File ./scripts/build-android-release.ps1 -BuildType release",
    "android:upload": "pwsh -File ./scripts/upload-android-playstore.ps1",
    "android:add": "node scripts/native-android-project.mjs add",
    "android:sync": "node scripts/native-android-project.mjs sync",
    "android:open": "node scripts/native-android-project.mjs open",
    "android:install": "node scripts/native-android-project.mjs install",
    "check:encoding": "node scripts/check-encoding.mjs",
    "doctor": "node scripts/doctor.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "cloudflare:configure": "node scripts/configure-cloudflare.mjs",
    "cloudflare:migrate": "node scripts/apply-migrations.mjs",
    "deploy:cloudflare": "npm run build && npm run cloudflare:configure && npm run cloudflare:migrate && wrangler deploy --config dist/server/wrangler.self-host.json",
    "release:source": "node scripts/export-open-source.mjs",
    "android:guide": "node scripts/native-android-project.mjs guide"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "drizzle-orm": "0.45.2",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.27.0",
    "next": "16.3.8",
    "papaparse": "^5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "sharp": "0.35.5",
    "vinext": {
      "image-size": "2.0.4"
    }
  }
}
