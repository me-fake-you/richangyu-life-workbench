{
  "name": "richangyu-life-workbench",
  "version": "1.5.0",
  "description": "开源、隐私优先的个人生活操作系统：记录、计划、财务、兼职、情报与长期回顾。",
  "private": true,
  "license": "MIT",
  "keywords": [
    "life-os",
    "personal-dashboard",
    "self-hosted",
    "cloudflare",
    "pwa",
    "日记",
    "生活记录"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run check:encoding && npm run build",
    "check:encoding": "node scripts/check-encoding.mjs",
    "doctor": "node scripts/doctor.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "cloudflare:configure": "node scripts/configure-cloudflare.mjs",
    "cloudflare:migrate": "node scripts/apply-migrations.mjs",
    "deploy:cloudflare": "npm run build && npm run cloudflare:configure && npm run cloudflare:migrate && wrangler deploy --config dist/server/wrangler.self-host.json",
    "release:source": "node scripts/export-open-source.mjs"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "drizzle-orm": "0.45.2",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.6",
    "papaparse": "^5.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
